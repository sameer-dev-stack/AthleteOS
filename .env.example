# AthleteOS Environment Variables Template

# ── App & Site Configuration ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://athleteos.app
NEXT_PUBLIC_APP_URL=https://athleteos.app

# ── Supabase Credentials ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI Platform (Xiaomi MiMo) ─────────────────────────────────────────────────
MIMO_API_KEY=your-mimo-api-key
MIMO_MODEL=mimo-v2.5-pro

# ── Stripe Payments & Subscriptions ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_ID_PRO=price_pro_subscription_id
STRIPE_PRICE_ID_ELITE=price_elite_subscription_id

# ── Resend Email Service ─────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── Security & System Secrets ────────────────────────────────────────────────
CRON_SECRET=your-random-cron-secret
ANALYTICS_IP_HASH_SECRET=your-analytics-ip-hash-secret

# ── Optional Integrations & Analytics ────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project
APIFY_API_KEY=your_apify_api_key
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
